{
  "name": "@idea-garden/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DB_PATH=${DB_PATH:-../../data/garden.db} node --experimental-strip-types --watch src/index.ts",
